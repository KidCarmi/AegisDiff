# AegisDiff — Environment Variables
# Copy to .env for local development with scripts/local_scan.py
# GitHub Actions uses the secrets defined in your repo settings (not this file)

# ── LLM API Keys (optional — platform provides 100 scans/day free) ──────
# Get free at: https://openrouter.ai/keys (no credit card required)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# ── Optional: Dashboard Ingest ───────────────────────────────────────────
# Your Vercel dashboard URL + /api/ingest
AEGISDIFF_INGEST_URL=
# Generated when you connect the repo in the dashboard (legacy — OIDC is preferred)
AEGISDIFF_REPO_TOKEN=

# ── Optional: Error Tracking ─────────────────────────────────────────────
SENTRY_DSN=
