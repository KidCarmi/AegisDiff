 from django.http import JsonResponse
+import pickle
+import yaml

 def status(request):
     return JsonResponse({"ok": True})

+def restore_session(request):
+    session_data = request.body
+    obj = pickle.loads(session_data)
+    return JsonResponse({"restored": str(obj)})
+
+def load_config(request):
+    raw = request.body.decode()
+    cfg = yaml.load(raw)
+    return JsonResponse(cfg)
